# === IDE & Editor Files ===
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# === OS Files ===
.DS_Store
Thumbs.db
Desktop.ini

# === Agentic / AI Folders & Files ===
# Use `.claude/*` (not `.claude/`) so shared config can be re-included below;
# an excluded parent directory makes any child negation inert.
.claude/*
!.claude/settings.json
.cursor/
.windsurf/
.references/
.copilot/
.aider*
.gdoc-sync/

# === Documentation ===
# Project docs (BUGFIX_*, OPTIMIZATION*, TRANSLATION_*, TROUBLESHOOTING) are
# intentionally TRACKED: they carry context for contributors, CI, and code review.
# Only ephemeral scratch planning files are ignored here.
findings.md
progress.md
task_plan.md

# === Node / NPM ===
# Lockfiles are deliberately NOT ignored: they pin the exact dependency tree
# and belong in version control for reproducible installs.
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# === Composer / PHP ===
/vendor/

# === Build / Distribution ===
/dist/
/build/
*.zip
*.tar.gz

# === Environment & Configuration ===
.env
.env.*
!.env.example
sftp.json
*.local.conf
.ftpconfig
.sftp-config.json
settings.local.json
wp-config.php

# === Credentials, Keys & Certificates ===
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# === Private / Sensitive Documents ===
# docs/private/ is the primary mechanism: anything dropped there stays local
# without further .gitignore edits. The name patterns below are a root-level
# safety net and are .md-suffixed so they can never catch source files.
docs/private/
SECURITY_AUDIT*.md
PENTEST*.md
*_CREDENTIALS*.md

# === Database Dumps & Data Exports ===
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
*.mdb
*.csv
*.xls
*.xlsx

# === Cache & Temporary Files ===
*.log
error_log
debug.log
*.tmp
*.temp
.sass-cache/
.cache/

# === Testing ===
/tests/coverage/
phpunit.xml
.phpunit.result.cache

# === Backup Files ===
*.bak
*.swp
*~
*.old
*.orig

# === PHP Linting ===
.phpcs.xml
.phplint-cache
.phpcs.cache
phpcs.xml
